{
  "name": "@kentra-saas/ui-kit",
  "version": "0.1.1",
  "private": false,
  "description": "Kentra Angular UI Kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kentra-SaaS/ui-kit.git"
  },
  "main": "dist/fesm2022/kentra-saas-ui-kit.mjs",
  "module": "dist/fesm2022/kentra-saas-ui-kit.mjs",
  "types": "dist/types/kentra-saas-ui-kit.d.ts",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./layout": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./typography": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./actions": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./icons": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./forms": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./navigation": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./patterns": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./data-display": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./feedback": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./overlays": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    },
    "./charts": {
      "types": "./dist/types/kentra-saas-ui-kit.d.ts",
      "default": "./dist/fesm2022/kentra-saas-ui-kit.mjs"
    }
  },
  "files": [
    "dist",
    "styles.css",
    "assets"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:icons": "node scripts/generate-icon-names.mjs",
    "build:maps": "npm run build:icons && tsc -p tsconfig.style-maps.json && node .cache/style-map-generator/scripts/generate-component-style-maps.js",
    "build:styles": "npm run build:maps && sass styles/styles.scss styles.css --no-source-map",
    "build": "npm run build:styles && ng-packagr -p ng-package.json",
    "dev": "npm run build:styles && ng-packagr -p ng-package.json -w",
    "test": "npm run build:styles && vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "echo \"No lint configured yet\"",
    "pack:dry": "npm pack --dry-run",
    "publish": "npm publish"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "tslib": "^2.7.0"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@angular/forms": "^21.2.1",
    "@angular/router": "^21.2.1",
    "@types/node": "^25.4.0",
    "ng-packagr": "^21.0.0",
    "sass": "^1.83.4",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
